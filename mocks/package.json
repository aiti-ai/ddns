{
  "name": "@aiti-ai/ddns-mocks",
  "version": "0.1.0",
  "description": "ddns provider 的 in-memory mock server（联调/测试用，独立于运行时包）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"fs.cpSync('src/assets','dist/assets',{recursive:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@aiti-ai/ddns": "^0.2.0"
  },
  "devDependencies": {
    "@aiti-ai/ddns": "file:.."
  }
}
