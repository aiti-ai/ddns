{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "paths": {
      "@aiti-ai/ddns": [
        "../dist/index.d.ts"
      ],
      "@aiti-ai/ddns/*": [
        "../dist/*.d.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts"
  ]
}