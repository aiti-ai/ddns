{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "types/*.d.ts"],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "paths": {
      "@aiti-ai/ddns": ["./src/index.ts"],
      "@aiti-ai/ddns/*": ["./src/*.ts"]
    }
  }
}
