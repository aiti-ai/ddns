{
  "name": "@aiti-ti/ddns",
  "version": "0.2.0",
  "description": "DDNS + DNS record management, multi-provider. Merges ddns-updater (Go) record-value updates with lexicon (Python) arbitrary record CRUD — every provider ships a mock implementation so the full flow is testable offline.",
  "type": "module",
  "bin": {
    "ddns": "./src/cli.ts",
    "ddns-cli": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./rest-specs": {
      "types": "./dist/providers/rest-specs.d.ts",
      "default": "./dist/providers/rest-specs.js"
    },
    "./dyndns-services": {
      "types": "./dist/providers/dyndns-services.d.ts",
      "default": "./dist/providers/dyndns-services.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\"",
    "verify": "bash scripts/test.sh"
  },
  "keywords": [
    "ddns",
    "dynamic-dns",
    "dns",
    "cloudflare",
    "dnspod",
    "aliyun",
    "alidns",
    "duckdns",
    "webhook",
    "dns-record",
    "dns-updater",
    "cname",
    "txt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "@aiti-ti/ddns-mocks": "file:mocks"
  }
}
